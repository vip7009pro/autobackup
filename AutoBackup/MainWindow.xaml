<Window x:Class="AutoBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:viewmodels="clr-namespace:AutoBackup.ViewModels"
        Title="Auto Backup" 
        Height="600" 
        Width="900"
        MinHeight="500"
        MinWidth="700"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    
    <Grid>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Resources/Icons/app_icon.ico"
                        ToolTipText="Auto Backup"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Auto Backup" Command="{Binding ShowWindowCommand}" FontWeight="Bold"/>
                    <MenuItem Header="Backup Now" Command="{Binding BackupAllCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header + Dashboard -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- Top Bar -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="🔄 Auto Backup - Hung Nguyen" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚙ Settings" 
                                Style="{StaticResource SecondaryButton}"
                                Click="SettingsButton_Click"
                                Margin="0,0,8,0"/>
                        <Button Content="📋 Logs" 
                                Style="{StaticResource SecondaryButton}"
                                Click="LogsButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Status Dashboard -->
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Last Backup -->
                        <StackPanel Grid.Column="0">
                            <Label Content="Last Backup" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LastBackupTimeDisplay}" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderBrush}" Margin="12,4"/>

                        <!-- Next Backup -->
                        <StackPanel Grid.Column="2">
                            <Label Content="Schedule" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding NextBackupTime}" 
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource BorderBrush}" Margin="12,4"/>

                        <!-- Status -->
                        <StackPanel Grid.Column="4">
                            <Label Content="Status" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding GlobalStatus}" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="5" Width="1" Fill="{StaticResource BorderBrush}" Margin="12,4"/>

                        <!-- Progress -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Total Progress" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" 
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercentage}" 
                                         Maximum="100" 
                                         Height="6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            
            <!-- Backup Items List -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Add Button -->
                    <Button Grid.Row="0" 
                            Content="➕ Add Backup Folder" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddItemCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"/>
                    
                    <!-- Items List -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding BackupItems}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Status Indicator -->
                                    <Ellipse Grid.Column="0" 
                                             Width="10" Height="10" 
                                             Fill="{Binding Status, Converter={StaticResource StatusToColor}}"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center"/>
                                    
                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SourceDisplay}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"/>
                                            <TextBlock Text=" → " 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding TargetDisplay}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding LastBackupDisplay}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text=" • " 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding StatusDisplay}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✏️" 
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                ToolTip="Edit"/>
                                        <Button Content="🗑️" 
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                ToolTip="Delete"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Visibility="{Binding BackupItems.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="No backup folders configured" 
                                   FontSize="16" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Click 'Add Backup Folder' to get started" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Progress Section -->
            <Border Grid.Row="2" 
                    Style="{StaticResource Card}" 
                    Margin="0,16,0,0"
                    Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14"/>
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercentage}" 
                                 Maximum="100" 
                                 Height="6"/>
                    <TextBlock Text="{Binding CurrentFile}" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            
            <!-- Action Buttons -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style x:Key="AutoCollapseButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>

                    <Button Command="{Binding ResumeCommand}" Content="▶ Resume" Style="{StaticResource AutoCollapseButton}" Margin="0,0,8,0"/>
                    <Button Command="{Binding PauseCommand}" Content="⏸ Pause" Style="{StaticResource AutoCollapseButton}" Margin="0,0,8,0"/>

                    <Button Content="Stop" 
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CancelBackupCommand}"
                            Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,8,0"/>
                    <Button Content="▶ Backup Now" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BackupAllCommand}"
                            IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
