<Application x:Class="AutoBackup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoBackup.Converters"
             Startup="Application_Startup"
             Exit="Application_Exit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:InverseBoolConverter x:Key="InverseBool"/>
            <converters:StatusToColorConverter x:Key="StatusToColor"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColor"/>
            <converters:BytesToSizeConverter x:Key="BytesToSize"/>
            <converters:NullToBoolConverter x:Key="NullToBool"/>
            <converters:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
