<Window x:Class="AutoBackup.Views.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Logs" 
        Height="500" 
        Width="800"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Filters -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Label Content="Filter:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding LogLevels}"
                      SelectedItem="{Binding FilterLevel}"
                      Width="120"
                      Margin="8,0,16,0"/>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     VerticalAlignment="Center"/>
            <Button Content="🔄 Refresh" 
                    Style="{StaticResource IconButton}"
                    Command="{Binding RefreshCommand}"
                    Margin="16,0,0,0"/>
        </StackPanel>
        
        <!-- Log List -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListBox ItemsSource="{Binding FilteredEntries}"
                     SelectedItem="{Binding SelectedEntry}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Level Indicator -->
                            <Border Grid.Column="0" 
                                    Width="4" 
                                    Background="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                    CornerRadius="2"
                                    Margin="0,0,12,0"/>
                            
                            <!-- Timestamp -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Width="60"
                                       VerticalAlignment="Center"/>
                            
                            <!-- Message -->
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Message}" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BackupItemName}" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Visibility="{Binding BackupItemName, Converter={StaticResource NullToBool}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        
        <!-- Actions -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Clear Logs" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearCommand}"
                    Margin="0,0,8,0"/>
            <Button Content="Export" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ExportCommand}"
                    Margin="0,0,8,0"/>
            <Button Content="Close" 
                    Style="{StaticResource PrimaryButton}"
                    Click="CloseButton_Click"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>
