<Window x:Class="AutoBackup.Views.Dialogs.EditBackupItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Backup Item" 
        Height="500" 
        Width="550"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <!-- Name -->
            <Label Content="Name (optional)"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,16"/>
            
            <!-- Source Path -->
            <Label Content="Source Folder"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" 
                        Content="Browse" 
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseSourceCommand}"
                        Margin="8,0,0,0"/>
            </Grid>
            
            <!-- Target Path -->
            <Label Content="Target Folder (Backup Location)"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" 
                        Content="Browse" 
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseTargetCommand}"
                        Margin="8,0,0,0"/>
            </Grid>
            
            <!-- Options -->
            <CheckBox Content="Include subfolders" 
                      IsChecked="{Binding IncludeSubfolders}"
                      Margin="0,0,0,8"/>
            <CheckBox Content="Enabled" 
                      IsChecked="{Binding Enabled}"
                      Margin="0,0,0,8"/>
            <CheckBox Content="Keep version history (backup old files with timestamp)" 
                      IsChecked="{Binding VersionBackup}"
                      Margin="0,0,0,16"/>
            
            <!-- Exclude Patterns -->
            <Label Content="Exclude patterns (one per line, e.g., *.tmp, node_modules)"/>
            <TextBox Text="{Binding ExcludePatterns, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="100"/>
            
            <!-- Validation Message -->
            <TextBlock Text="{Binding ValidationMessage}" 
                       Foreground="{StaticResource ErrorBrush}"
                       FontSize="12"
                       Margin="0,8,0,0"/>
        </StackPanel>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button Content="Cancel" 
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"
                    Margin="0,0,8,0"
                    Width="100"/>
            <Button Content="Save" 
                    Style="{StaticResource PrimaryButton}"
                    Click="SaveButton_Click"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>
